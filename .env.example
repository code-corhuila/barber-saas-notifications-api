# Names and placeholders only: never a real value. Copy to .env for local runs.
PORT=8080
# SPKI PEM public key, one line with \n escapes. barber-saas-infra-postgres/scripts/dev-keys.sh generates a development one.
JWT_PUBLIC_KEY=
# Explicit limits (norm 5.3.10): idle keep-alive, drain time on SIGTERM, concurrent connections.
HTTP_KEEP_ALIVE_TIMEOUT_S=5
HTTP_GRACEFUL_SHUTDOWN_S=10
HTTP_MAX_CONCURRENCY=200
# Empty MONGO_URL: in-memory repositories (no database needed to try the HTTP contract).
# Set: mongodb://notifications_app:<password>@localhost:27017/notifications?authSource=notifications&directConnection=true
MONGO_URL=
MONGO_DATABASE=notifications
MONGO_POOL_MAX=10
MONGO_TIMEOUT_MS=5000
MONGO_SERVER_SELECTION_TIMEOUT_MS=3000
